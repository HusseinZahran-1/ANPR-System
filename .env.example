# Local settings only. Copy to .env and provide trusted compatible weights.
MODEL_DETECTOR_PATH=models/local/detector.pt
MODEL_OCR_PATH=models/local/ocr.pt
CAMERA_DETECTOR_PATH=
DETECTION_CONF=0.25
DETECTION_IMGSZ=1280
DETECTION_NMS_IOU=0.50
DETECTION_MAX_PLATES=1
OCR_LAYOUT_MODE=rectify_unfold_wide_v3
DEVICE=cpu
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png
# Generate independent random secrets before enabling camera ingestion.
CAMERA_API_KEY=
CAMERA_ISAPI_TOKEN=
