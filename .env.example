# Local settings only. Copy to .env and provide trusted compatible weights.
MODEL_DETECTOR_PATH=models/local/detector.pt
MODEL_OCR_PATH=models/local/ocr.pt
CAMERA_DETECTOR_PATH=
# Optional second pass, used only when the primary detector returns no boxes.
FALLBACK_DETECTOR_PATH=
FALLBACK_DETECTION_CONF=0.05
# Optional single-plate fallback geometry; original component boxes remain in results.
FALLBACK_MERGE_FRAGMENTS=false
# Optional final pass, only after primary and fallback both return no boxes.
RECOVERY_DETECTOR_PATH=
RECOVERY_DETECTION_CONF=0.05
RECOVERY_OCR_LAYOUT_MODE=rectify_unfold_rows_v5
DETECTION_CONF=0.25
DETECTION_IMGSZ=1280
DETECTION_NMS_IOU=0.50
DETECTION_MAX_PLATES=1
# Optional geometry pilot: rectify_unfold_rows_v4; see docs/ROW_LAYOUT.md.
OCR_LAYOUT_MODE=rectify_unfold_wide_v3
# Optional pilot: install requirements-authority.txt and supply verified local weights.
AUTHORITY_REGION_MODEL_PATH=
AUTHORITY_PREFIX_MIN_CONF=0.8
DEVICE=cpu
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png
# Generate independent random secrets before enabling camera ingestion.
CAMERA_API_KEY=
CAMERA_ISAPI_TOKEN=
